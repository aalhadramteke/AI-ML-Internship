# ======== API ========
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs
# Comma-separated list, e.g. http://localhost:3000 (empty = CORS disabled)
ALLOWED_ORIGINS=
# Set a long random value in production; clients send it as the X-API-Key header
API_KEY=
# Parallel research runs allowed (local LLMs: keep at 1)
MAX_CONCURRENT_RESEARCH=1

# Simulated I/O delays in seconds (used by the v1/v2 benchmark endpoints)
DB_DELAY=0.3
EXTERNAL_DELAY=0.2
EMAIL_DELAY=2.0

# ======== Multi-agent research assistant ========
# ollama | openai_compat | hf_local | hf_api | anthropic
RA_BACKEND=ollama
RA_OLLAMA_MODEL=qwen2.5:3b
RA_OLLAMA_HOST=http://localhost:11434
RA_OLLAMA_CTX=8192
# local | web | both
RA_SOURCE=local
RA_DOCS_DIR=docs
RA_OUTPUT_DIR=output
RA_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RA_MAX_SOURCES=8
RA_SOURCE_CHARS=800

# Only if you switch backend:
# RA_OPENAI_BASE=http://localhost:1234/v1
# RA_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# HF_TOKEN=
